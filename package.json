{
  "name": "remark-relgeo-hl",
  "version": "0.5.0",
  "description": "Remark plugin for RelGeo source highlighting in fenced code `rg` blocks",
  "homepage": "https://relgeo.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/relgeo/remark-relgeo-hl.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "remark",
    "markdown",
    "relgeo",
    "highlight"
  ],
  "author": "Agus Made",
  "license": "MIT",
  "dependencies": {
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "relgeo-language-service": "^0.4.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "relgeo-language-service": "^0.4.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
